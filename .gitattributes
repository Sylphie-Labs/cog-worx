# Normalize line endings: LF in the repo, native on checkout where it matters.
* text=auto eol=lf
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.cjs text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# hive-client: the .claude/hooks/*.sh files run under /bin/sh on macOS/Linux and must stay LF in every checkout.
*.sh text eol=lf
