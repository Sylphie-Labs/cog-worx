# Copy to .env for local development. Defaults match docker-compose.yml on a clean machine, so on a
# host with no port conflicts you do not need a .env at all. Set these only to override (e.g. when
# another local stack already holds Neo4j 7474/7687 or Postgres 5432).
#
# COGWORX_NEO4J_HTTP_PORT=7474   # docker compose host port -> container 7474
# COGWORX_NEO4J_BOLT_PORT=7687   # docker compose host port -> container 7687
# COGWORX_PG_PORT=5432           # docker compose host port -> container 5432
#
# COGWORX_NEO4J_URI=bolt://localhost:7687
# COGWORX_NEO4J_USER=neo4j
# COGWORX_NEO4J_PASSWORD=cogworx-test
# COGWORX_PG_DSN=postgresql://postgres:cogworx-test@localhost:5432/cogworx
