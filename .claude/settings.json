{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebSearch",
      "WebFetch",
      "Agent",
      "Bash(*)",
      "PowerShell(Get-ChildItem *)",
      "Skill(update-config)",
      "mcp__codebase-pkg__*"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(.envrc)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(!.env.dist)",
      "Read(!.env.defaults)",
      "Read(!.env.*.example)",
      "Read(!.env.*.sample)",
      "Read(!.env.*.template)",
      "Read(!.env.*.dist)",
      "Read(!.env.*.defaults)",
      "Read(id_rsa)",
      "Read(id_dsa)",
      "Read(id_ecdsa)",
      "Read(id_ed25519)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pgpass)",
      "Read(~/.git-credentials)",
      "Read(~/.docker/config.json)",
      "Read(~/.kube/config)",
      "Read(~/.claude.json)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.config/hive/**)",
      "Edit(~/.config/hive/**)",
      "Read(~/AppData/Roaming/hive/**)",
      "Edit(~/AppData/Roaming/hive/**)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push * production*)",
      "Bash(git push *:production*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"let d='';process.stdin.on('data',c=>d+=c);process.stdin.on('end',()=>{const cmd=(JSON.parse(d).tool_input.command)||'';if(/CANON\\.md/.test(cmd)&&/(\\brm\\b|\\bmv\\b|\\bdel\\b|Remove-Item|Move-Item|Clear-Content|>\\s*[^|]*CANON)/i.test(cmd)){console.log(JSON.stringify({decision:'block',reason:'wiki/CANON.md is immutable law (CANON \\u00a76) \\u2014 change it only via the /update-canon skill with Jim\\u2019s approval, never raw rm/mv/redirect.'}));process.exit(2)}});\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.sh\" git-guard",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.sh\" secret-guard",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/doc-check.cjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/canon-check.cjs",
            "timeout": 120
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/hook.sh\" hive-scribe-capture",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
