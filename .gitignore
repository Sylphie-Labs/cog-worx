# machine-local runtime state, capture buffer, and init backups.
.memory-pkg/state.json
.memory-pkg/inject-errors.log
.memory-pkg-backup-*/
.claude/memory/

# codebase-pkg generated sync state (machine-local; .last-sync-commit + state.json)
.codebase-pkg/

# Machine-local MCP server config (contains absolute, per-machine paths)
.mcp.json
# Claude Code settings backups
.claude/*.bak-*
